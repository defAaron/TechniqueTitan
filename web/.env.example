# API origin for production builds (no trailing slash).
# Local dev: leave empty — Vite proxies /v1 → http://127.0.0.1:8000
# Production (Vercel): https://technique-titan-api.onrender.com
VITE_API_BASE_URL=

# Dedicated Technique Titan Supabase project (never the service_role key).
# URL and key must be from the same project as Vercel. The JWT "ref" must match
# the URL hostname (wrong/deleted ref → Safari "can't find server" on Google OAuth).
# Paste the full anon/publishable key as one line (no quotes or wraps). Local: .env.local.
# Production: set on Vercel and redeploy (Vite bake-time).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional on-device tip wording (docs/PERSONALIZED_COACH.md §7). These are a
# public Hugging Face repo id and its commit SHA, not secrets. Leave both empty
# to hide the "Varied tip wording" toggle; set both only after the ONNX upload.
VITE_COACH_MODEL_REPO=
VITE_COACH_MODEL_REVISION=
