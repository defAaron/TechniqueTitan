# Virtual environments (any name)
.venv/
venv/
venv*/
.venv*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local env (keep *.example tracked)
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# OS / IDE
.DS_Store
.idea/
.vscode/
.cursor/
# Generated batch outputs (reproducible from data/raw/)
data/processed/

# Generated eval reports (frozen split data/eval/holdout_split.json stays tracked)
data/eval/reports/

# Raw labeled images (keep folder structure via .gitkeep)
data/raw/**
!data/raw/.gitkeep

# Local smoke / ad-hoc images (not the labeled severity set)
data/fixtures/**
!data/fixtures/.gitkeep

# Frontend
web/node_modules/
web/dist/
web/dist-ssr/

# Accidental npm at repo root (frontend lives in web/)
/package.json
/package-lock.json
/node_modules/

# Unoptimized source media. Web-served copies live under web/public/.
assets/source/**
!assets/source/.gitkeep
/photo_mode.mp4
/video_mode.mp4
